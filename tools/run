#!/bin/sh
set -eu
TASK_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$TASK_ROOT"
TASK_PYTHON=${PYTHON:-"$TASK_ROOT/.venv/bin/python"}
export PYTHONPATH="$TASK_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
if [ -n "${GODOT:-}" ]; then TASK_GODOT=$GODOT
elif command -v godot >/dev/null 2>&1; then TASK_GODOT=$(command -v godot)
elif command -v godot4 >/dev/null 2>&1; then TASK_GODOT=$(command -v godot4)
elif [ -x "$HOME/Applications/Godot.app/Contents/MacOS/Godot" ]; then TASK_GODOT="$HOME/Applications/Godot.app/Contents/MacOS/Godot"
else TASK_GODOT=/Applications/Godot.app/Contents/MacOS/Godot
fi
TASK_ACTION=${1:-run-demo}
if [ "$#" -gt 0 ]; then shift; fi
run_godot_validation() {
 TASK_LOG=$(mktemp "${TMPDIR:-/tmp}/flyswarm-godot-validation.XXXXXX")
 if "$TASK_GODOT" "$@" >"$TASK_LOG" 2>&1; then
  if grep -E 'SCRIPT ERROR:|Parse Error:|Failed to load script' "$TASK_LOG" >/dev/null; then
   cat "$TASK_LOG" >&2
   rm -f "$TASK_LOG"
   return 1
  fi
  cat "$TASK_LOG"
  rm -f "$TASK_LOG"
 else
  TASK_EXIT=$?
  cat "$TASK_LOG" >&2
  rm -f "$TASK_LOG"
  return "$TASK_EXIT"
 fi
}
# A fresh checkout has GLBs but no local Godot import cache.
case "$TASK_ACTION" in
 run-demo|run-open-day|run-battle|run-training|run-tests|run-ballistics-test|run-profile|headless)
  if [ ! -d frontend/godot/.godot/imported ]; then
   "$TASK_GODOT" --headless --editor --path frontend/godot --import
  fi ;;
esac
case "$TASK_ACTION" in
 run-demo) exec "$TASK_GODOT" --path frontend/godot -- --legacy-battle "$@" ;;
 run-open-day) exec "$TASK_GODOT" --path frontend/godot -- --open-day "$@" ;;
 run-battle) exec "$TASK_GODOT" --path frontend/godot -- --connect "$@" ;;
 run-brains) exec "$TASK_PYTHON" -m flyswarm.bridge.server "$@" ;;
 run-training) exec "$TASK_PYTHON" tools/training_smoke.py --godot "$TASK_GODOT" "$@" ;;
 run-tests)
  "$TASK_PYTHON" -m unittest discover -s tests -v
  run_godot_validation --headless --path frontend/godot --script res://scripts/validation.gd
  run_godot_validation --headless --path frontend/godot --script res://scripts/app/environment_physics_validation.gd
  run_godot_validation --headless --path frontend/godot --script res://scripts/app/bridge_protocol_validation.gd
  run_godot_validation --headless --path frontend/godot --script res://scripts/app/historical_map_validation.gd
  run_godot_validation --headless --path frontend/godot --script res://scripts/app/open_day_validation.gd ;;
 run-ballistics-test) exec "$TASK_GODOT" --headless --path frontend/godot --script res://scripts/validation.gd ;;
 run-profile) exec "$TASK_GODOT" --path frontend/godot --script res://scripts/app/performance_profile.gd -- "$@" ;;
 headless) exec "$TASK_GODOT" --headless --path frontend/godot -- --legacy-battle "$@" ;;
 *) echo "Unknown command: $TASK_ACTION" >&2; exit 2 ;;
esac
